{
  "expo": {
    "name": "Yatri",
    "slug": "yatri",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "yatri",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yatri uses your location for nearby stays, navigation, district guidance, and SOS coordinates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07060f"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
